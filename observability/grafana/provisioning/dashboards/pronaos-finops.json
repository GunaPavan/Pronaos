    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cache hit rate — hits / (hits + miss). Skip-bucket excluded so streaming traffic doesn't artificially depress the number.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pronaos_cache_lookups_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(pronaos_cache_lookups_total{result=~\"hit|miss\"}[5m])), 0.0001)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "title": "Cache hit rate (last 5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative cache decisions by outcome over time. Watching the gap between hit and miss lines is the cache-effectiveness story.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 15 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result)(rate(pronaos_cache_lookups_total[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Cache lookups by outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-model spend over the selected time range. Click a row's header to sort.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "model" },
            "properties": [{ "id": "custom.width", "value": 380 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 6,
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": true },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider, model)(increase(pronaos_provider_cost_hcents_total[$__range])) / 10000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Spend by model (range)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "provider": 0, "model": 1, "Value": 2 },
            "renameByName": { "Value": "spend ($)" }
          }
        }
      ],
      "type": "table"
    }
