# Pronaos admin UI — example env. Copy to .env.local for dev.

# Backend FastAPI URL — dev server proxies /v1/* requests here.
PRONAOS_API_URL=http://localhost:8000

# Mounted base path in production (set when serving from FastAPI's /admin/).
# Leave unset for dev (serves at /).
# PRONAOS_UI_BASE_PATH=/admin
