# Local dev databases — never commit. ``pronaos.db`` is the SQLite file
# the dev workflow uses; production should use Postgres. Test runs create
# additional ``*.db`` and ``*.db-*`` (WAL/journal) files.
*.db
*.db-journal
*.db-wal
*.db-shm

# Eval run artifacts — generated by ``pronaos-cli eval run -o <path>``
# and the scripts in ``scripts/eval_*.py``. Includes raw judge replies
# so they're large and uninteresting in VCS.
eval-results/

# Claude Code local settings — personal per-machine preferences for
# permissions, hooks, etc. Not committed; the project-wide settings
# (if any) live in .claude/settings.json which IS committed.
.claude/settings.local.json
