# ------------------------------------------------------------------
# Pronaos — environment configuration
# Copy to .env and adjust. Never commit .env.
# ------------------------------------------------------------------

# ---- Core ----
PRONAOS_ENV=development              # development | staging | production
PRONAOS_LOG_LEVEL=info               # debug | info | warning | error
PRONAOS_HOST=0.0.0.0
PRONAOS_PORT=8080

# ---- Security ----
PRONAOS_SECRET_KEY=change-me-in-production
PRONAOS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
# Local dev defaults to SQLite — no install, file at ./pronaos.db.
# For production switch to Postgres:
#   PRONAOS_DATABASE_URL=postgresql+asyncpg://pronaos:pronaos@localhost:5432/pronaos
PRONAOS_DATABASE_URL=sqlite+aiosqlite:///./pronaos.db

# ---- Redis (rate limits + L1 exact cache + distributed circuit breaker) ----
# Uncomment to use Redis-backed rate limiter (multi-worker safe).
# Leaving this commented out runs the in-memory limiter (zero-install dev path).
# PRONAOS_REDIS_URL=redis://localhost:6379/0

# ---- Vector store (L2 semantic cache) ----
PRONAOS_QDRANT_URL=http://localhost:6333
PRONAOS_QDRANT_API_KEY=

# ---- Semantic cache (Phase 7.2) ----
# OFF by default — opts you in to PyTorch + a 250 MB embedding model (~1-2 s
# startup cost). Production deployments set this true.
PRONAOS_SEMANTIC_CACHE_ENABLED=false
# Cosine similarity floor for L2 hits. Lower = more hits, more false-positive
# risk. 0.95 = strong paraphrase match for all-MiniLM-L6-v2.
PRONAOS_SEMANTIC_CACHE_THRESHOLD=0.95

# ---- Guardrails (Phase 8) ----
# Set false to skip all guardrail scanning (e.g. for interactive
# prompt-engineering work where false-positives are a nuisance).
PRONAOS_GUARDRAILS_ENABLED=true

# ---- ML PII detection — Presidio (Phase 22) ----
# OFF by default — Presidio pulls in spaCy + recognizers (~600 MB disk,
# ~250 MB RAM, ~1-2 s startup). Set true on regulated workloads. The
# per-team guardrail policy then decides which entities to actually run.
PRONAOS_PRESIDIO_ENABLED=false
# Minimum confidence (0..1) for a Presidio hit to count. Lower = more
# recall, more false positives. 0.5 is Presidio's own recognizer default.
PRONAOS_PRESIDIO_MIN_SCORE=0.5

# ---- Distributed circuit breaker (Phase 25) ----
# OFF by default — a single-process gateway doesn't benefit and the
# in-memory breaker is lower-latency. Set true behind a load balancer with
# multiple gateway replicas so they share trip state via Redis. Requires
# PRONAOS_REDIS_URL to be set.
PRONAOS_CIRCUIT_BREAKER_DISTRIBUTED=false

# ---- Native MCP server adapter (Phase 48) ----
# OFF by default. When true, the gateway exposes pronaos.chat /
# pronaos.embed / pronaos.rerank as MCP tools at /v1/mcp/sse — MCP
# clients (Claude Code, IDE tools, Anthropic Workbench) target the
# gateway directly with full auth/quotas/audit/routing applied.
# Authentication uses the same Bearer-token Pronaos API key the REST
# endpoints accept; the SSE handshake requires the chat:write scope.
PRONAOS_MCP_ENABLED=false

# ---- OIDC / SSO admin auth (Phase 26) ----
# When PRONAOS_OIDC_ISSUER is set, the gateway accepts Bearer JWTs alongside
# API keys. JWT signature is verified against the issuer's JWKS; the `sub`
# claim resolves to a tenant via tenants.oidc_subject. NULL issuer disables
# the OIDC path entirely — API-key auth is unaffected.
# PRONAOS_OIDC_ISSUER=https://your-idp.example.com/realms/pronaos
# PRONAOS_OIDC_AUDIENCE=pronaos-gateway
# Override only if the JWKS layout differs from {issuer}/.well-known/...
# Defaults: Keycloak uses /protocol/openid-connect/certs; Auth0 uses
# /.well-known/jwks.json; Google uses /oauth2/v3/certs.
# PRONAOS_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# ---- Observability ----
PRONAOS_OTEL_ENABLED=true
PRONAOS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PRONAOS_OTEL_SERVICE_NAME=pronaos

# ---- Provider credentials (leave blank to disable a provider) ----
# Anthropic native adapter (separate from the OpenAI-compat adapter).
ANTHROPIC_API_KEY=

# OpenAI-compat providers — one adapter, 11 backends. Leave blank to skip.
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Phase 31/32: embedding + rerank providers (Cohere and Voyage serve both endpoints).
COHERE_API_KEY=
VOYAGE_API_KEY=

# Azure OpenAI — needs both the key and the resource endpoint.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local / self-hosted OpenAI-compat endpoint (default points at Ollama).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- AWS Bedrock (native, SigV4-signed; Phase 42 + Phase 52) ----
# Provide BOTH access key + secret key to enable the ``bedrock``
# provider. Region defaults to ``us-east-1`` — Bedrock model
# availability is per-region; set explicitly for any non-US-East-1.
# Optional session token for STS short-lived creds.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ---- GCP Vertex AI (native, service-account JWT auth; Phase 53) ----
# Provide BOTH project_id + service-account JSON to enable the
# ``vertex`` provider. The SA JSON setting accepts EITHER an inline
# JSON string OR a path to the JSON file on disk — the auth helper
# auto-detects which it received. The standard GCP env var
# ``GOOGLE_APPLICATION_CREDENTIALS`` is also accepted as a fallback
# for the SA JSON path. Region defaults to ``us-central1`` (broadest
# Vertex model availability).
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_SERVICE_ACCOUNT_JSON=

# ---- LlamaGuard jailbreak detector (Phase 44) ----
# Uses a Groq-hosted PromptGuard / LlamaGuard model as an async ingress
# check. Opt-in per gateway; further opt-in/out per team via guardrail_policy.
PRONAOS_LLAMA_GUARD_ENABLED=false
PRONAOS_LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-4-12B

# ---- Batch API background worker (Phase 59) ----
# Enable the background polling worker that tracks submitted batch jobs and
# marks them completed when the provider finalises them.
PRONAOS_BATCHES_WORKER_ENABLED=true
PRONAOS_BATCHES_POLL_INTERVAL_SECONDS=30

# ---- Quality monitor (Phase 40) ----
# Default judge model used by the quality-monitor sampler when no
# per-team judge model is configured.
PRONAOS_QUALITY_DEFAULT_JUDGE_MODEL=groq/llama-3.1-8b-instant

# ---- Singleflight (Phase 33/36) ----
# Seconds before a singleflight leader slot expires (safety net for hung
# upstream calls). Applies to both in-memory and Redis-backed registries.
PRONAOS_SINGLEFLIGHT_TTL_SECONDS=30
